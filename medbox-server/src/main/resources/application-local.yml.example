# medbox-server/src/main/resources/application-local.yml  ← 不入库（已在仓库根 .gitignore 中）
#
# 用法一（推荐）：复制本文件为 application-local.yml，填自己的值，启动时加
#   --spring.profiles.active=local
# 用法二（更省事）：不建这个文件，直接在 IDE 的 Run Configuration 里配环境变量
#   MEDBOX_HOST=192.168.1.23
#
# 只放「因人而异」的配置；与机器无关的内容一律写在入库的 application.yml 里。
# 见文档 01 的 4.5。

medbox:
  host: 192.168.1.23        # ← 改成自己电脑在局域网里的 IP

  # JWT 签名密钥（HS256，≥32 字节）。不配就用 application.yml 里的本地开发默认值；
  # 一旦改了它，已签发的 token 全部失效，需要重新登录。
  jwt:
    secret: please-change-this-to-a-long-random-string

  # —— 本地 AI 服务（feat/backend-ai-infra）——
  # Ollama 与 RapidOCR 的地址在入库的 application.yml 已默认指向本机 localhost，一般无需覆盖；
  # 若侧车不在本机，改这里即可：
  # ocr:
  #   provider: local
  #   endpoint: http://localhost:8000/ocr

  # —— WebSocket（feat/backend-ws，见文档 04）——
  # 本地用 wscat 验收"能收到后端主动推送的告警帧"时，打开调试推送端点（生产务必保持关闭）：
  # ws:
  #   debug-endpoint-enabled: true

  # —— 设备（feat/device-core，见文档 02 第 4 章）——
  # 药箱注册时的兜底值，一般不用动；只有当产品型号 / 默认时区与默认值不同时才覆盖：
  # device:
  #   default-product-key: medbox-box    # Topic 第 2 层：medbox/{productKey}/{deviceId}/...
  #   default-timezone: Asia/Shanghai

  # —— MQTT（feat/backend-mqtt，见文档 03）——
  # EMQX 在本机时无需覆盖（默认 tcp://localhost:1883）；本机没起 EMQX 就用下面的开关跳过连接，应用仍能正常启动：
  # mqtt:
  #   enabled: false
  # Topic 前缀与下行 ack 重发参数一般也不用动，要调见 application.yml 里的默认值。
