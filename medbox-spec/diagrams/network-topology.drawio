                    </mxGeometry>
                </mxCell>
                <mxCell id="camera" value="&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;摄像头&lt;/b&gt;（药品识别）&lt;br&gt;识别结果经 WiFi 交主控聚合&lt;br&gt;抓拍图片 HTTP 直传后端（全量）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede0f0;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1">
                    <mxGeometry x="1270" y="-110" width="210" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="pg" value="&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;PostgreSQL 17 + pgvector&lt;/b&gt;&lt;br&gt;:5432（本机 localhost）&lt;br&gt;结构化数据 + 说明书向量同库&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1f8;strokeColor=#2a6f97;fontSize=12;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1">
                    <mxGeometry x="560" y="-40" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="ocr" value="&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;本地 OCR 侧车&lt;/b&gt;（RapidOCR）&lt;br&gt;http://localhost:8000/ocr&lt;br&gt;不出网 · 无需 Key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1">
                    <mxGeometry x="560" y="85" width="240" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="embed" value="&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;本地 Embedding&lt;/b&gt;（Ollama bge-m3）&lt;br&gt;http://localhost:11434&lt;br&gt;不出网 · 无需 Key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1">
                    <mxGeometry x="560" y="185" width="240" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="说明：当前阶段所有服务均在同一局域网内；小程序不直连 MQTT（设备消息由后端经 WebSocket 中转）；OCR 与 Embedding 已本地化、不出网；仅公网大模型 API 为后端出网方向。" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;wrap=1;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="990" y="310" width="470" height="90" as="geometry"/>
