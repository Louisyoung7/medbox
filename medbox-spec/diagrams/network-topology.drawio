<mxfile host="65bd71144e">
    <diagram id="medbox-net-topo" name="网络拓扑结构">
        <mxGraphModel dx="3932" dy="4060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="mp" value="&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;uni-app 小程序端&lt;/b&gt;&lt;br&gt;&lt;br&gt;老人本人端（近场本地）&lt;br&gt;子女 / 监护人端（远程监护）&lt;br&gt;社区护理人员端（机构监护）&lt;br&gt;家庭医生端（专业端）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="190" y="-352.5" width="210" height="205" as="geometry"/>
                </mxCell>
                <mxCell id="backend" value="&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;Java 后端&lt;/b&gt;（Spring Boot 4）&lt;br&gt;REST :8080 / WS :8080&lt;br&gt;context-path /medbox&lt;br&gt;落库 · 判定 · 推送&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="560" y="-340" width="240" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="emqx" value="&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;EMQX MQTT Broker&lt;/b&gt;&lt;br&gt;TCP :1883（局域网内网）&lt;br&gt;Dashboard :18083&lt;br&gt;本期匿名连接&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="980" y="-320" width="210" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="master" value="&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;药箱主控&lt;/b&gt;（单片机 / 嵌入式网关）&lt;br&gt;定时提醒 · 人机交互 · WiFi&lt;br&gt;唯一 MQTT 连接（聚合子设备）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="1270" y="-315" width="210" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="主控统一上报" style="edgeStyle=none;rounded=1;html=1;strokeWidth=2;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1376" y="-420" as="sourcePoint"/>
                        <mxPoint x="1376" y="-315" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="sensor" value="&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;传感器子设备&lt;/b&gt;（温湿度 / 光照…）&lt;br&gt;无独立 MQTT 连接，经主控转发&lt;br&gt;消息带 sensorId 标明来源&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede0f0;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1">
                    <mxGeometry x="1270" y="-510" width="210" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="WiFi 聚合&lt;br&gt;（识别结果）" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;labelBackgroundColor=#FFFFFF;strokeWidth=2;fontSize=10;fontColor=#6b4a7a;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="camera" target="master">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="HTTP multipart 图片直传&lt;br&gt;（不过 MQTT / 不过主控）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;labelBackgroundColor=#FFFFFF;strokeWidth=2;fontSize=10;fontColor=#6b4a7a;fillColor=#dae8fc;strokeColor=#6c8ebf;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.556;entryDx=0;entryDy=0;" edge="1" parent="1" source="camera" target="backend">
